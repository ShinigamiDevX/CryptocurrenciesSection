# Copia questo file in .env e compila i valori
# Il file .env NON viene mai committato nel repository

# URL pubblico del portale (usato nei link email)
PORTAL_URL=https://192.168.4.77:5200

# ── Configurazione SMTP per l'invio automatico degli inviti ──────────────────
# Se SMTP_HOST è vuoto, i link vengono mostrati solo nel pannello admin.
#
# Esempi provider:
#   Gmail:       smtp.gmail.com  port 587  secure false  (usa App Password)
#   Outlook:     smtp.office365.com  port 587  secure false
#   ProtonMail:  richiede ProtonMail Bridge in esecuzione sull'host
#                SMTP_HOST=host-gateway  SMTP_PORT=1025  SMTP_SECURE=false
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=portalecrypto@proton.me
SMTP_PASS=
SMTP_FROM=CryptocurrenciesSection <portalecrypto@proton.me>

# SHA-256 hex della frase easter-egg (mai in chiaro nel codice client).
# Genera con:  node -e "console.log(require('crypto').createHash('sha256').update('FRASE','utf8').digest('hex'))"
# Se vuoto, il server usa l'hash di default integrato.
ELEVATE_PHRASE_HASH=

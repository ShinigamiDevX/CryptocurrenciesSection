# Copia questo file in .env e compila i valori
# Il file .env NON viene mai committato nel repository

# URL pubblico del portale (usato nei link email)
PORTAL_URL=https://cryptosection.chainholder.dev

# Strumenti esterni (SSO dal portale)
CHAINHOLDER_URL=http://192.168.1.73:3000
CRYPTOMONITOR_URL=https://192.168.4.80:5173

# Let's Encrypt (DNS-01 su Vercel). Team ID solo se chainholder.dev è in un team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_yI4DGB0A87z1XRbkHEWKLnfH

# ── Configurazione SMTP ─────────────────────────────────────────────────────
# Se SMTP_HOST è vuoto, OTP/inviti restano solo nei log / pannello admin.
#
# Resend (consigliato, dominio chainholder.dev):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=<API key re_...>
#   SMTP_FROM=CryptocurrenciesSection <noreply@chainholder.dev>
#
# Altri esempi:
#   Gmail:       smtp.gmail.com  port 587  secure false  (App Password)
#   Outlook:     smtp.office365.com  port 587  secure false
#   ProtonMail:  Bridge sull'host → SMTP_HOST=host.docker.internal  SMTP_PORT=1025  SMTP_SECURE=false
#
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=CryptocurrenciesSection <noreply@chainholder.dev>

# SHA-256 hex della frase easter-egg (mai in chiaro nel codice client).
# Genera con:  node -e "console.log(require('crypto').createHash('sha256').update('FRASE','utf8').digest('hex'))"
# Se vuoto, il server usa l'hash di default integrato.
ELEVATE_PHRASE_HASH=

# ── Cluster (Chainalysis / TRM) ─────────────────────────────────────────────
# I valori reali stanno in cluster.env (committato, repo privato, per cambiare PC).
# Docker Compose lo carica da solo. Non duplicarli qui.
# CHAINALYSIS_API_TOKEN=
# TRM_API_KEY=

# ── Analisi Report — IP intelligence (VPN / proxy / Tor) ────────────────────
# Priorità: IPQualityScore + Spur + IPGeolocation.io (tutte le chiavi presenti
# vengono interrogate e i risultati uniti). Senza chiavi: IPLogs (nessuna key).
# Se IPLogs non è raggiungibile (es. filtro ISP/TIM Guardian): vpnapi.io +
# proxycheck.io + IPLocate.io.
IPQS_API_KEY=
SPUR_API_TOKEN=
IPGEOLOCATION_API_KEY=

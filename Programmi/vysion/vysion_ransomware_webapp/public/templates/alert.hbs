<html>
    <body>
        <table>
            <tbody>
                <tr>
                    <td style="padding: 32px; background-color: #000000; border-radius: 3px 3px 0px 0px">
                        <div
                            style="
                                color: #ffffff;
                                font:
                                    15px Robot-Medium,
                                    Roboto,
                                    Verdana,
                                    sans-serif;
                                letter-spacing: 0.1px;
                                display: inline-block;
                            "
                        >
                            <span style="vertical-align: middle; display: inline-block; margin-left: 3px">Vysion
                                Ransomware Alert Report</span>
                        </div>
                        <div
                            style="
                                color: #ffffff;
                                font:
                                    24px Roboto-Medium,
                                    Roboto,
                                    Verdana,
                                    sans-serif;
                                padding-top: 14px;
                                line-height: 32px;
                                font-weight: bold;
                            "
                        >
                            New ransomware activity detected
                        </div>
                    </td>
                </tr>
                <tr>
                    <td
                        style="
                            background-color: #000000;
                            font:
                                16px Roboto-Medium,
                                Roboto,
                                Verdana,
                                sans-serif;
                            color: #ffffff;
                            letter-spacing: 0;
                            min-height: 40px;
                            height: 40px;
                            font-weight: 500;
                        "
                    >
                        <table
                            role="presentation"
                            style="
                                width: 100%;
                                margin: auto;
                                border: none;
                                border-collapse: collapse;
                                color: white;
                                font-size: 18px;
                            "
                        >
                            <thread>
                                <tr style="border-bottom: 1px solid white; height: 2rem">
                                    <th>Keyword</th>
                                    <th>Search Type</th>
                                    <th>New Detections</th>
                                    <th>Detected at</th>
                                </tr>
                            </thread>
                            <tbody>
                                {{#alertsList}}
                                    <tr style="height: 2.5rem">
                                        <th>{{keyword}}</th>
                                        <th>{{type}}</th>
                                        <th>{{newHits}}</th>
                                        <th>{{createdAt}}</th>
                                    </tr>
                                {{/alertsList}}

                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td
                        style="
                            padding: 16px 32px 0 32px;
                            color: #455a64;
                            background-color: #ffffff;
                            font:
                                16px Roboto-Medium,
                                Roboto,
                                Verdana,
                                sans-serif;
                            line-height: 25px;
                        "
                    >
                        <p>
                            <span style="font-weight: bold">Username</span><br />
                            <span style="font-weight: normal">{{userName}}</span>
                        </p>
                        <p>
                            <span style="font-weight: bold">Account ID</span><br />
                            <span style="font-weight: normal">{{userId}}</span>
                        </p>
                        <p>
                            You can check the details in the Vysion Ransomware web app
                            <b>alerts page</b>.
                        </p>
                    </td>
                </tr>
                <tr>
                    <td
                        style="
                            padding: 16px 32px 32px 32px;
                            color: #455a64;
                            background-color: #ffffff;
                            font:
                                14px Roboto-Medium,
                                Roboto,
                                Verdana,
                                sans-serif;
                            border-radius: 0px 0px 3px 3px;
                        "
                    >
                        <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tbody>
                                <tr>
                                    <td>
                                        <table
                                            role="presentation"
                                            align="center"
                                            border="0"
                                            cellspacing="0"
                                            cellpadding="0"
                                            style="text-align: center; margin-left: auto; margin-right: auto"
                                        >
                                            <tbody>
                                                <tr></tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: center; padding: 32px">
                        <div
                            style="
                                color: #757575;
                                letter-spacing: 0;
                                line-height: 16px;
                                font:
                                    12px Robot-Regular,
                                    Roboto,
                                    Verdana,
                                    sans-serif;
                                font-weight: 400;
                            "
                        >
                            <div>© {{year}} Byron Labs</div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </body>
</html>